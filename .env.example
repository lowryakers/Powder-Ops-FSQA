PORT=3000
DB_PATH=./data/compliance.db

# Two origins, and they are NOT interchangeable — see server/links.js.
#
# APP_BASE_URL is the public front door. It serves the workspace launcher, and
# Twilio computes its webhook signature over this exact origin, so it must match
# the URL entered in the Twilio console character for character.
APP_BASE_URL=https://start.powder-ops.com
#
# READYDOC_ORIGIN is where the app itself is served, and every link we GENERATE
# points at it — approval magic links, push deep links, schedule digests.
#
# SET THIS TO A BRANDED DOMAIN. Texted links are scanned by the carriers under
# A2P 10DLC, and a shared free-hosting subdomain (*.up.railway.app) cannot be
# told apart from anyone else's traffic on that host, which is how approval
# texts start being filtered silently. Add the domain in Railway first — a
# value that does not resolve breaks every generated link.
READYDOC_ORIGIN=https://app.powder-ops.com
