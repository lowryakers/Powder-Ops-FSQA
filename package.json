{
  "name": "preventative-maintenance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FSQA Compliance & Preventive Maintenance Platform \u2014 SQF/NSF audit-ready digital ledger for single-site food manufacturing",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
    "seed": "node server/seed.js",
    "backup": "node scripts/backup-db.js",
    "lint": "eslint .",
    "check:routes": "node scripts/check-route-order.mjs",
    "check:boot": "node scripts/check-fresh-boot.mjs",
    "check:endpoints": "node scripts/check-endpoints.mjs",
    "check": "npm run lint && npm run build && npm run check:routes && npm run check:migrations && npm run check:boot && npm run check:endpoints && npm run check:suppliers && npm run check:invoices && npm run check:reclean && npm run check:readiness && npm run check:eqready && npm run check:swabs && npm run check:obligations && npm run check:ncstatus && npm run check:docworklist && npm run check:modaccess && npm run check:dupreadings",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:invoices": "node scripts/check-invoice-figures.mjs",
    "check:reclean": "node scripts/check-reclean-titles.mjs",
    "check:readiness": "node scripts/check-product-readiness.mjs",
    "check:composer": "node scripts/verify-composer-caret.mjs",
    "check:eqready": "node scripts/check-equipment-staleness.mjs",
    "check:reactions": "node scripts/verify-reaction-tooltip.mjs",
    "check:swabs": "node scripts/check-swab-stock.mjs",
    "check:obligations": "node scripts/check-obligations.mjs",
    "verify": "npm run lint && npm run build && npm run check:routes && npm run check:boot && npm run check:endpoints",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:suppliers": "node scripts/check-supplier-archive.mjs && node scripts/check-supplier-reconcile.mjs && node scripts/check-supplier-import.mjs && node scripts/check-supplier-review.mjs && node scripts/check-supplier-storage.mjs",
    "check:ncstatus": "node scripts/check-nc-status.mjs",
    "check:docworklist": "node scripts/check-doc-worklist.mjs",
    "check:modaccess": "node scripts/check-module-access.mjs",
    "check:dupreadings": "node scripts/check-duplicate-readings.mjs",
    "verify:backdate": "node scripts/verify-backdated-recurrence.mjs",
    "verify:onboarding": "node scripts/verify-onboarding.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/lib-storage": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1088.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.1.200",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
